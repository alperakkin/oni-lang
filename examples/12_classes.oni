class car
{
    @car(str name, int speed)
    {
        this.name = name
        this.speed = speed
    }

    @add_speed(){
        this.speed++
    }

    @info(){
        print("Car Info")
        print("--------")
        print(this.name)
        print(this.speed)
    }

}

int a = 1
obj c = car("Ferrari", 2)
c.add_speed()
c.info()

!:obj d = car("Maserati", 3)
!:d.info()

!:print(c)
!:print(d)